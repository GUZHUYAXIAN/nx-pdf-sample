<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Exact local Siemens references selected by NxGeneration. Shared by tools
    and Workers so each generation binds to its verified assembly
    versions. Private=false: Siemens DLLs are never copied to output, never
    committed, never redistributed. At runtime they are loaded from the local
    NX installation that launched the process via its matching managed launcher.
  -->

  <PropertyGroup>
    <NxGeneration Condition="'$(NxGeneration)' == ''">10</NxGeneration>
    <NxRoot Condition="'$(NxRoot)' == '' and '$(NxGeneration)' == '10'">D:\Program Files\Siemens\NX 10.0</NxRoot>
    <NxRoot Condition="'$(NxRoot)' == '' and '$(NxGeneration)' == '2506'">D:\Program Files\Siemens\NX2506</NxRoot>
    <NxBinName Condition="'$(NxGeneration)' == '10'">UGII</NxBinName>
    <NxBinName Condition="'$(NxGeneration)' == '2506'">NXBIN</NxBinName>
    <NxManagedDir>$(NxRoot)\$(NxBinName)\managed</NxManagedDir>
    <NxOpenDll>$(NxManagedDir)\NXOpen.dll</NxOpenDll>
    <NxOpenUfDll>$(NxManagedDir)\NXOpen.UF.dll</NxOpenUfDll>
    <NxOpenUtilitiesDll>$(NxManagedDir)\NXOpen.Utilities.dll</NxOpenUtilitiesDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="NXOpen">
      <HintPath>$(NxOpenDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NXOpen.UF">
      <HintPath>$(NxOpenUfDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BaseSession lives here; required to compile against NXOpen types. -->
    <Reference Include="NXOpen.Utilities">
      <HintPath>$(NxOpenUtilitiesDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyLocalNxAssemblies" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NxOpenDll)')"
           Text="本机 NX $(NxGeneration) 未找到 NXOpen.dll：$(NxOpenDll)。只允许引用该代际已验证的本机组件。" />
    <Error Condition="!Exists('$(NxOpenUfDll)')"
           Text="本机 NX $(NxGeneration) 未找到 NXOpen.UF.dll：$(NxOpenUfDll)。只允许引用该代际已验证的本机组件。" />
    <Error Condition="!Exists('$(NxOpenUtilitiesDll)')"
           Text="本机 NX $(NxGeneration) 未找到 NXOpen.Utilities.dll：$(NxOpenUtilitiesDll)。只允许引用该代际已验证的本机组件。" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)verify-nx-references.ps1&quot; -ManagedDirectory &quot;$(NxManagedDir)&quot; -Generation &quot;$(NxGeneration)&quot;" />
  </Target>

</Project>
