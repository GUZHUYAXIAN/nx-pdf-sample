<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Validation-only gate host (not part of the product or the release).
    Loads the production PdfSharpInspector from the App project so gate
    evidence comes from the same managed inspection code the product uses.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NxDrawingPdfExporter.PdfGate</RootNamespace>
    <AssemblyName>NxDrawingPdfExporter.PdfGate</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NxDrawingPdfExporter.App\NxDrawingPdfExporter.App.csproj" />
  </ItemGroup>

</Project>
