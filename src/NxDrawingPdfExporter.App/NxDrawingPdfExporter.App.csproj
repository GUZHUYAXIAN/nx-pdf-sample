<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Portable WinForms GUI. Never references NXOpen; NX access is delegated to
    the separate Worker process. References PDFsharp for managed read-only PDF
    inspection (MIT, see THIRD-PARTY-NOTICES.txt).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NxDrawingPdfExporter.App</RootNamespace>
    <AssemblyName>NxDrawingPdfExporter.App</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NxDrawingPdfExporter.Contracts\NxDrawingPdfExporter.Contracts.csproj" />
    <ProjectReference Include="..\NxDrawingPdfExporter.Core\NxDrawingPdfExporter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NxDrawingPdfExporter.App.Tests" />
  </ItemGroup>

</Project>
